@implements IAsyncDisposable
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms

<main class="shell">
    <h1>ZX_sharp — Spectrum 48K</h1>
    <p class="hint">Browser proof of concept using the existing SpectrumPC core.</p>
    <canvas @ref="_canvas" class="screen" width="352" height="296" tabindex="0"
            aria-label="ZX Spectrum emulated screen; click to enable keyboard input"></canvas>
    <div class="controls">
        <button @onclick="ToggleRunning">@(_running ? "Pause" : "Run")</button>
        <button @onclick="Reset">Reset</button>
        <label for="program-file">Load TAP / Z80</label>
        <InputFile id="program-file" OnChange="LoadProgramAsync" accept=".tap,.z80" />
        @if (_loadedTape)
        {
            <button @onclick="PlayTape">Play tape</button>
            <button @onclick="StopTape">Stop tape</button>
        }
        <span>@_status</span>
    </div>
    <p class="hint">Click the screen for keyboard input. Shift = CAPS SHIFT, Ctrl = SYMBOL SHIFT.
        TAP: enter LOAD "" in Spectrum BASIC, then click Play tape. Z80: snapshot starts immediately.
        Audio output is not yet available.</p>
    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
</main>

@code {
    private const int FrameWidth = 352;
    private const int FrameHeight = 296;
    private readonly SpectrumPC.Hardware.Computer _computer = new();
    private readonly byte[] _rgba = new byte[FrameWidth * FrameHeight * 4];
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SpectrumScreen>? _self;
    private CancellationTokenSource? _cts;
    private Task? _loopTask;
    private bool _running = true;
    private string _status = "Starting";
    private string? _error;
    private bool _loadedTape;
    private const long MaxProgramSize = 4 * 1024 * 1024;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/spectrumCanvas.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initialize", _canvas, _self);
            _cts = new CancellationTokenSource();
            _loopTask = RunFramesAsync(_cts.Token);
            _status = "Running — click screen for keyboard";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _status = "Failed to initialize";
            StateHasChanged();
        }
    }

    private async Task RunFramesAsync(CancellationToken cancellationToken)
    {
        // Each ExecuteCycle simulates one complete 50 Hz Spectrum frame.
        // Task.Delay yields to the browser event loop; this is a simple first version,
        // not a precision audio-driven scheduler.
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                if (_running && _module is not null)
                {
                    _computer.ExecuteCycle();
                    _computer.DisplayUnit.GetDisplayBuffer();
                    var pixels = _computer.DisplayUnit.PixelBuffer;
                    for (var i = 0; i < pixels.Length; i++)
                    {
                        int color = pixels[i];
                        int offset = i * 4;
                        _rgba[offset] = (byte)(color >> 16);
                        _rgba[offset + 1] = (byte)(color >> 8);
                        _rgba[offset + 2] = (byte)color;
                        _rgba[offset + 3] = 255;
                    }
                    await _module.InvokeVoidAsync("render", _canvas, _rgba);
                }
                await Task.Delay(20, cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception ex)
        {
            _error = ex.Message;
            _running = false;
            _status = "Emulator error";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadProgramAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        bool wasRunning = _running;
        _running = false;
        _error = null;
        _status = $"Loading {file.Name}...";
        try
        {
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (extension is not (".tap" or ".z80"))
                throw new NotSupportedException("Choose a .tap or .z80 file.");
            if (file.Size == 0 || file.Size > MaxProgramSize)
                throw new InvalidDataException("File must be between 1 byte and 4 MB.");

            await using var stream = file.OpenReadStream(MaxProgramSize);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            _computer.LoadProgram(file.Name, buffer.ToArray());
            _loadedTape = extension == ".tap";
            _status = _loadedTape
                ? $"Mounted {file.Name}. Enter LOAD \"\" in BASIC, then press Play tape."
                : $"Loaded snapshot {file.Name}.";
        }
        catch (Exception ex)
        {
            _error = $"Could not load {file.Name}: {ex.Message}";
            _status = "Load failed";
        }
        finally
        {
            _running = wasRunning;
            StateHasChanged();
        }
    }

    private void PlayTape()
    {
        _computer.TapeDevice.Play();
        _status = "Tape playing";
    }

    private void StopTape()
    {
        _computer.TapeDevice.Stop();
        _status = "Tape stopped";
    }

    private void ToggleRunning()
    {
        _running = !_running;
        _status = _running ? "Running" : "Paused";
    }

    private void Reset()
    {
        _computer.Reset();
        _status = "Reset";
    }

    [JSInvokable]
    public Task OnKeyChanged(string name, bool isDown)
    {
        if (Enum.TryParse<SpectrumPC.Hardware.SpectrumKeyCode>(name, out var key))
        {
            _computer.KeyInput(key, isDown);
        }
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            if (_loopTask is not null)
            {
                try { await _loopTask; }
                catch (OperationCanceledException) { }
            }
            _cts.Dispose();
        }
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _canvas);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
